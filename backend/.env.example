# Server Configuration
PORT=5000

# GNews API Key (https://gnews.io)
GNEWS_API_KEY=your_gnews_api_key_here

# Unsplash Access Key (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pixabay API Key (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Daily Automated News Video Scheduler
ENABLE_DAILY_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_CATEGORY=general
SCHEDULER_TEMPLATE=breaking
SCHEDULER_VOICE=en-US-GuyNeural
SCHEDULER_ASPECT_RATIO=16:9

